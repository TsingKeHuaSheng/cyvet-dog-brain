# 统一换行符：脚本一律 LF，避免在 Windows / Linux 之间来回改文件时整文件 diff
* text=auto eol=lf

*.sh   text eol=lf
*.bash text eol=lf
*.py   text eol=lf
*.cpp  text eol=lf
*.hpp  text eol=lf
*.h    text eol=lf
*.yaml text eol=lf
*.yml  text eol=lf
*.json text eol=lf
*.xml  text eol=lf
*.md   text eol=lf
*.txt  text eol=lf

# 点云 / 地图：二进制，禁止 git 做文本 diff 和换行转换
*.pcd     binary
*.pgm     binary
*.png     binary
*.pdf     binary
*.onnx    binary
*.pt      binary
*.engine  binary
