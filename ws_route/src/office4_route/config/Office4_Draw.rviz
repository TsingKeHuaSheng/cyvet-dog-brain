        Depth: 1
        Durability Policy: Transient Local
        Reliability Policy: Reliable
        Value: /line_route/route_corridor
      Value: true
    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Name: Front box (blue) and intersection (green)
