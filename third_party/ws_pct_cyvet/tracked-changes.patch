@@ -1,4 +1,5 @@
 """仅定位当前 ROS2 包内的原 PCT 扩展，避免依赖 cwd 或手动 LD_LIBRARY_PATH。"""
+import ctypes
 import importlib
 import sys
 from pathlib import Path
@@ -7,5 +8,9 @@ from ament_index_python.packages import get_package_prefix
 
 def load_native():
     native_dir = Path(get_package_prefix('global_planner')) / 'lib/global_planner/native'
+    # ROS Humble also ships GTSAM 4.2 under the same SONAME as PCT 4.1.
+    # Load both package-local libraries before importing their C++ callers.
+    ctypes.CDLL(str(native_dir / "libmetis-gtsam.so"))
+    ctypes.CDLL(str(native_dir / "libgtsam.so.4"))
     sys.path.insert(0, str(native_dir))
     return tuple(importlib.import_module(name) for name in ('a_star', 'ele_planner', 'traj_opt'))
